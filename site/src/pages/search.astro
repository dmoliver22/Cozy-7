---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { graph, breadcrumbs } from '../lib/schema';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Search', path: '/search/' }];
---
<BaseLayout title="Search The Oxytocin Report" description="Search every verdict, guide, trial and update on The Oxytocin Report." path="/search/" jsonLd={graph(breadcrumbs(crumbs))} noindex={true}>
  <div class="wrap-narrow article-head"><Breadcrumbs items={crumbs} /><h1>Search</h1><p class="dek">Every page on the site, searchable. Press the search icon in the header, or <kbd>/</kbd> on any page, for the quick version.</p>
    <p><button class="btn btn-dark" type="button" data-open-search>Open search</button></p>
  </div>
</BaseLayout>
