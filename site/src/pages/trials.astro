---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { graph, breadcrumbs } from '../lib/schema';
import data from '../data/trials.json';
import catalysts from '../data/catalysts.json';

const statusClass = (s: string) => {
  const t = s.toLowerCase();
  if (t.includes('terminated') || t.includes('withdrawn')) return 'terminated';
  if (t.includes('recruiting') && !t.includes('not recruiting')) return 'recruiting';
  if (t.includes('active')) return 'active';
  if (t.includes('completed')) return 'completed';
  return 'unknown';
};
const statusLabel = (s: string) => ({ terminated: 'Terminated', recruiting: 'Recruiting', active: 'Active', completed: 'Completed', unknown: 'Status unclear' } as Record<string, string>)[statusClass(s)];
const clusters = [...new Set(data.trials.map((t) => t.cluster))];
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Trial tracker', path: '/trials/' }];
const jsonLd = graph(breadcrumbs(crumbs), {
  '@type': 'Dataset',
  name: 'Oxytocin human clinical trial tracker',
  description: 'Registered human trials of oxytocin for non-obstetric uses, with status, sponsor and why each matters.',
  url: new URL('/trials/', Astro.site).toString(),
  dateModified: data.asOf,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@id': `${Astro.site}#organization` },
});
---
<BaseLayout title="Oxytocin clinical trial tracker: every active human study" description="Every registered human oxytocin trial for relationships, tinnitus, pain, menopause, PTSD, addiction and deficiency: status, sponsor, expected results, why it matters." path="/trials/" jsonLd={jsonLd}>
  <div class="wrap article-head">
    <Breadcrumbs items={crumbs} />
    <h1>Oxytocin trial tracker</h1>
    <p class="dek">Every registered human trial we're watching, grouped by what it could change. Status as of {data.asOf}. Click an NCT number for the official registry entry.</p>
  </div>
  <div class="wrap section" style="padding-top:0">
    <h2>Next results, in order</h2>
    <ol class="timeline">
      {catalysts.map((c) => (<li><span class="when">{c.when}</span><span class="what"><strong>{c.what}</strong>{c.detail} <a href={`/oxytocin-for/${c.slug}/`}>Our verdict →</a></span></li>))}
    </ol>
  </div>
  {clusters.map((cl) => (
    <div class="wrap section" style="padding-top:1rem">
      <h2 style="font-size:1.5rem">{cl}</h2>
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>Trial</th><th>Status</th><th>Sponsor</th><th>Dates</th><th>Why it matters</th></tr></thead>
          <tbody>
            {data.trials.filter((t) => t.cluster === cl).map((t) => (
              <tr>
                <td class="nct"><a href={`https://clinicaltrials.gov/study/${t.nct}`} rel="noopener" target="_blank">{t.nct}</a><div style="margin-top:.3rem;color:var(--ink)">{t.title}</div></td>
                <td><span class={`status status-${statusClass(t.status)}`}>{statusLabel(t.status)}</span><div class="small muted" style="margin-top:.3rem">{t.status}</div></td>
                <td>{t.sponsor}</td>
                <td>{t.dates}</td>
                <td>{t.why}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ))}
  <div class="wrap section">
    <div class="callout"><strong>How we build this.</strong> We pull every study on ClinicalTrials.gov that lists oxytocin as an intervention, exclude labor and obstetric uses, and keep the ones that could change a verdict on this site. Statuses are checked against the registry; dates are the registry's estimates and slip often. Missing one? <a href="/about/#contact">Tell us</a>.</div>
  </div>
  <section class="wrap section"><NewsletterForm compact /></section>
</BaseLayout>
