---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import EvidenceSnapshot from '../../components/EvidenceSnapshot.astro';
import WhatWorks from '../../components/WhatWorks.astro';
import Faq from '../../components/Faq.astro';
import Sources from '../../components/Sources.astro';
import Toc from '../../components/Toc.astro';
import ReviewNote from '../../components/ReviewNote.astro';
import ConditionCard from '../../components/ConditionCard.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { graph, breadcrumbs, article, faqPage } from '../../lib/schema';
import { fmtDate, readingTime } from '../../lib/format';
import type { Verdict } from '../../lib/verdict';
import type { PartnerKey } from '../../lib/partners';

export async function getStaticPaths() {
  const entries = await getCollection('conditions');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const path = `/oxytocin-for/${entry.id}/`;
const image = `/og/oxytocin-for/${entry.id}.png`;
const all = await getCollection('conditions');
const related = all.filter((c) => d.relatedSlugs.includes(c.id)).slice(0, 3);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Conditions', path: '/oxytocin-for/' }, { name: d.condition, path }];
const jsonLd = graph(
  breadcrumbs(crumbs),
  article({ path, headline: d.title, description: d.description, published: d.lastReviewed, modified: d.updated, image, medical: { condition: d.condition, verdict: d.verdict as Verdict, lastReviewed: d.lastReviewed }, section: 'Conditions', keywords: ['oxytocin', d.condition.toLowerCase(), 'intranasal oxytocin', 'evidence'], wordCount: entry.body?.split(/\s+/).length, citations: d.sources }),
  faqPage(d.faq),
);
const tocExtra = [{ slug: 'what-works', text: `What works for ${d.condition.toLowerCase()}` }, ...(d.faq.length ? [{ slug: 'faq-h', text: 'Questions people ask' }] : []), { slug: 'sources-h', text: 'Sources' }];
---
<BaseLayout title={d.title} description={d.description} path={path} image={image} type="article" published={d.lastReviewed} modified={d.updated} jsonLd={jsonLd}>
  <header class="article-head">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <VerdictBadge verdict={d.verdict as Verdict} />
      <h1 style="margin-top:.75rem" transition:name={`cond-${entry.id}`}>{d.question}</h1>
      <p class="dek">{d.description}</p>
      <div class="byline">
        <span>By the {`The Oxytocin Report`.replace('The ', '')} editorial team</span>
        <span>Evidence reviewed {fmtDate(d.lastReviewed)}</span>
        <span>{readingTime(entry.body ?? '')} min read</span>
        <a href="/editorial-policy/">How we work</a>
      </div>
    </div>
  </header>
  <div class="wrap layout">
    <article>
      <EvidenceSnapshot verdict={d.verdict as Verdict} oneLiner={d.oneLiner} humanStudies={d.humanStudies} largestStudy={d.largestStudy} activeTrials={d.activeTrials} nextReadout={d.nextReadout} />
      <div class="prose" data-pagefind-body><Content /></div>
      <WhatWorks items={d.whatWorks} partnerKey={d.partnerKey as PartnerKey} condition={d.condition} />
      <Faq items={d.faq} />
      <Sources sources={d.sources} />
      <ReviewNote lastReviewed={d.lastReviewed} updated={d.updated} />
    </article>
    <Toc headings={headings} extra={tocExtra} />
  </div>
  {related.length > 0 && (
    <section class="wrap related">
      <h2>Related verdicts</h2>
      <div class="grid grid-3">
        {related.map((c) => (<ConditionCard slug={c.id} condition={c.data.condition} question={c.data.question} oneLiner={c.data.oneLiner} verdict={c.data.verdict as Verdict} humanStudies={c.data.humanStudies} activeTrials={c.data.activeTrials} />))}
      </div>
    </section>
  )}
  <section class="wrap section"><NewsletterForm compact /></section>
</BaseLayout>
