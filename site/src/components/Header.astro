---
import { SITE } from '../config';
const path = Astro.url.pathname;
const nav = [
  { href: '/oxytocin-for/', label: 'Conditions' },
  { href: '/guides/', label: 'Guides' },
  { href: '/trials/', label: 'Trials' },
  { href: '/pipeline/', label: 'Pipeline' },
  { href: '/updates/', label: 'Updates' },
  { href: '/about/', label: 'About' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}><span class="mark" aria-hidden="true"></span>{SITE.name}</a>
    <button class="theme-btn menu-btn" id="menu-btn" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <nav class="nav" id="site-nav" aria-label="Primary">
      {nav.map((n) => (<a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>))}
      <a class="cta" href="/quiz/">Take the quiz</a>
      <button class="theme-btn" type="button" data-open-search aria-label="Search (press slash)" title="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <button class="theme-btn" id="theme-btn" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </nav>
  </div>
</header>
<script>
  function init() {
  const btn = document.getElementById('theme-btn');
  const menu = document.getElementById('menu-btn');
  const nav = document.getElementById('site-nav');
  if (!btn || btn.dataset.ready) return;
  btn.dataset.ready = '1';
  btn.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.getAttribute('data-theme') === 'dark' || (!root.getAttribute('data-theme') && matchMedia('(prefers-color-scheme: dark)').matches);
    const next = dark ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch {}
  });
  menu?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    menu.setAttribute('aria-expanded', String(!!open));
    menu.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  }
  document.addEventListener('astro:page-load', init);
</script>
