---
interface Props { items: { q: string; a: string }[]; heading?: string }
const { items, heading = 'Questions people ask' } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" aria-labelledby="faq-h">
    <h2 id="faq-h">{heading}</h2>
    {items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <div class="a"><p>{f.a}</p></div>
      </details>
    ))}
  </section>
)}
