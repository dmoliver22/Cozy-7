---
import VerdictBadge from './VerdictBadge.astro';
import type { Verdict } from '../lib/verdict';
interface Props { slug: string; condition: string; question: string; oneLiner: string; verdict: Verdict; humanStudies: number; activeTrials: number }
const { slug, condition, question, oneLiner, verdict, humanStudies, activeTrials } = Astro.props;
---
<a class="card cond-card" href={`/oxytocin-for/${slug}/`}>
  <VerdictBadge verdict={verdict} size="sm" title={false} />
  <h3>{condition}</h3>
  <p class="q">{question}</p>
  <p class="one">{oneLiner}</p>
  <div class="meta"><span>{humanStudies} human {humanStudies === 1 ? 'study' : 'studies'}</span><span>{activeTrials} active {activeTrials === 1 ? 'trial' : 'trials'}</span></div>
</a>
